# Luma → Calendar → Settings → Developer → API Keys.
# Put the key HERE, never in the Edit panel and never in chat.
# Restart `pnpm dev` after changing this file.

LUMA_API_KEY=
# Optional. evt-... from the Luma event URL. Empty = nearest upcoming event.
LUMA_EVENT_ID=
# Cursor redeem links. Server only: the check-in response sends them after
# the event has started. Never put them in the client bundle.
CURSOR_LINK_NEW=
CURSOR_LINK_EXISTING=
